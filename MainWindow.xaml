<Window x:Class="ClipboardLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardLite"
        Title="ClipboardLite"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Manual">

    <Window.Resources>

        <local:ShortTextConverter x:Key="ShortTextConverter"/>
        <local:TileTextMaxHeightConverter x:Key="TileTextMaxHeightConverter"/>
        <local:ClipboardImageConverter x:Key="ClipboardImageConverter"/>
        <local:ClipboardTextVisibilityConverter x:Key="ClipboardTextVisibilityConverter"/>
        <local:ClipboardTitleConverter x:Key="ClipboardTitleConverter"/>
        <local:ClipboardTitleOnlyVisibilityConverter x:Key="ClipboardTitleOnlyVisibilityConverter"/>
        <local:ClipboardTitleCaptionVisibilityConverter x:Key="ClipboardTitleCaptionVisibilityConverter"/>
        <local:TileSelectedConverter x:Key="TileSelectedConverter"/>

        <!-- 탭 이름이 탭 폭보다 길 때 말줄임표로 정리 -->
        <DataTemplate x:Key="TabContentTemplate">
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"/>
        </DataTemplate>

        <Style x:Key="TabButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="{Binding DataContext.TabHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- 탭 폭은 타일 폭보다 살짝 좁게, 타일 설정에 맞춰 함께 변한다 -->
            <Setter Property="Width"
                    Value="{Binding DataContext.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="Margin"
                    Value="0,0,4,0"/>

            <Setter Property="Background"
                    Value="{Binding DataContext.TabBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Setter Property="Foreground"
                    Value="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <Setter Property="BorderBrush"
                    Value="#CCCCCC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="ContentTemplate"
                    Value="{StaticResource TabContentTemplate}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background"
                            Value="{Binding DataContext.SelectedTabBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>


    <Grid x:Name="MainRoot"
          Margin="6">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- 탭 영역 -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Height="{Binding TabHeight}">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="26"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="32"/>

            </Grid.ColumnDefinitions>


            <!-- 이전 탭 -->

            <Button x:Name="TabPrevButton"
                    Grid.Column="0"
                    Content="◀"
                    Click="TabPrev_Click"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="11"
                    Foreground="{Binding DataContext.TabArrowColor, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="0"
                    AllowDrop="True"
                    DragEnter="TabPrevArrow_DragEnter"
                    DragOver="TabArrow_DragOver"
                    DragLeave="TabArrow_DragLeave"/>


            <!-- 탭 -->

            <ItemsControl x:Name="TabsControl"
                          Grid.Column="1"
                          ItemsSource="{Binding VisibleTabs}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <StackPanel Orientation="Horizontal"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Button
                            Content="{Binding Name}"
                            Tag="{Binding}"
                            Style="{StaticResource TabButtonStyle}"
                            Click="TabButton_Click"
                            AllowDrop="True"
                            PreviewMouseLeftButtonDown="TabButton_MouseLeftButtonDown"
                            PreviewMouseMove="TabButton_MouseMove"
                            PreviewMouseLeftButtonUp="TabButton_MouseLeftButtonUp"
                            PreviewMouseRightButtonUp="TabButton_RightClick"
                            DragOver="TabButton_DragOver"
                            DragLeave="TabButton_DragLeave"
                            Drop="TabButton_Drop"/>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <!-- 다음 탭 -->

            <Button x:Name="TabNextButton"
                    Grid.Column="2"
                    Content="▶"
                    Click="TabNext_Click"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="11"
                    Foreground="{Binding DataContext.TabArrowColor, RelativeSource={RelativeSource AncestorType=Window}}"
                    Padding="0"
                    AllowDrop="True"
                    DragEnter="TabNextArrow_DragEnter"
                    DragOver="TabArrow_DragOver"
                    DragLeave="TabArrow_DragLeave"/>

            <!-- 여러 문구 선택 모드 전환 (예전엔 설정 버튼이었음.
                 설정은 트레이 아이콘 우클릭 메뉴에서 연다) -->
            <Button x:Name="MultiSelectToggleButton"
                    Grid.Column="3"
                    Content="✓"
                    Click="MultiSelectToggle_Click"
                    ToolTip="여러 문구 선택"
                    AutomationProperties.Name="여러 문구 선택"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#4A90D9"
                    Padding="0"/>

        </Grid>


        <!-- ================================================= -->
        <!-- 문구 타일 + 다중 선택 액션 바(겹쳐서 표시) -->
        <!-- ================================================= -->

        <Grid Grid.Row="1">

            <ScrollViewer x:Name="TileScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          ClipToBounds="True"
                          PreviewMouseWheel="TileArea_MouseWheel">

                <ItemsControl ItemsSource="{Binding CurrentItems}"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Top">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <UniformGrid
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,6,6,0"
                                Padding="10"
                                Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{Binding DataContext.TileBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                BorderBrush="#D8D8D8"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="ClipboardTile_MouseLeftButtonDown"
                                PreviewMouseMove="ClipboardTile_MouseMove"
                                PreviewMouseLeftButtonUp="ClipboardTile_MouseLeftButtonUp"
                                PreviewMouseRightButtonUp="ClipboardTile_RightClick">

                                <Grid>

                                    <!-- 대표 이미지: 설정돼 있을 때만 문구 대신 표시 -->
                                    <Image
                                        Source="{Binding Converter={StaticResource ClipboardImageConverter}}"
                                        Stretch="Uniform"/>

                                    <TextBlock
                                        Text="{Binding Converter={StaticResource ShortTextConverter}}"
                                        Visibility="{Binding Converter={StaticResource ClipboardTextVisibilityConverter}}"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        TextAlignment="Left"
                                        FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        FontFamily="{Binding DataContext.TileFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                        MaxHeight="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TileTextMaxHeightConverter}}"/>

                                    <!-- 제목: 대표 이미지 없이 제목만 설정돼 있을 때, 원문 대신 표시 -->
                                    <TextBlock
                                        Text="{Binding Converter={StaticResource ClipboardTitleConverter}}"
                                        Visibility="{Binding Converter={StaticResource ClipboardTitleOnlyVisibilityConverter}}"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        TextAlignment="Left"
                                        FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        FontFamily="{Binding DataContext.TileFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Foreground="{Binding DataContext.TileForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                        MaxHeight="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TileTextMaxHeightConverter}}"/>

                                    <!-- 제목 캡션: 대표 이미지와 제목이 둘 다 설정돼 있을 때,
                                         이미지 아래쪽에 제목을 자막처럼 겹쳐서 보여준다 -->
                                    <Border
                                        Visibility="{Binding Converter={StaticResource ClipboardTitleCaptionVisibilityConverter}}"
                                        VerticalAlignment="Bottom"
                                        Background="#99000000"
                                        CornerRadius="0,0,7,7"
                                        Padding="6,4"
                                        IsHitTestVisible="False">

                                        <TextBlock
                                            Text="{Binding Converter={StaticResource ClipboardTitleConverter}}"
                                            Foreground="White"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"/>

                                    </Border>

                                    <!-- 다중 선택 모드에서 선택된 타일 표시 -->
                                    <Border
                                        Visibility="{Binding Converter={StaticResource TileSelectedConverter}}"
                                        Background="#334A90D9"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"/>

                                    <Border
                                        Visibility="{Binding Converter={StaticResource TileSelectedConverter}}"
                                        Background="#4A90D9"
                                        CornerRadius="10"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-6"
                                        IsHitTestVisible="False">

                                        <TextBlock
                                            Text="✓"
                                            Foreground="White"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!-- 다중 선택 액션 바: 평소엔 숨김, 선택 모드일 때만 타일 위에 겹쳐서 표시 -->

            <Border x:Name="MultiSelectBar"
                    Visibility="Collapsed"
                    VerticalAlignment="Top"
                    Background="#4A90D9"
                    CornerRadius="0,0,8,8"
                    Padding="10,6">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="MultiSelectCountText"
                               Grid.Column="0"
                               Text="0개 선택됨"
                               Foreground="White"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <Button x:Name="MultiSelectAllButton"
                            Grid.Column="1"
                            Content="전체 선택"
                            Click="MultiSelectAll_Click"
                            Margin="4,0,0,0"
                            Padding="8,2"/>

                    <Button x:Name="MultiSelectMoveButton"
                            Grid.Column="2"
                            Content="이동"
                            Click="MultiSelectMove_Click"
                            Margin="4,0,0,0"
                            Padding="8,2"/>

                    <Button x:Name="MultiSelectDeleteButton"
                            Grid.Column="3"
                            Content="삭제"
                            Click="MultiSelectDelete_Click"
                            Margin="4,0,0,0"
                            Padding="8,2"/>

                    <Button Grid.Column="4"
                            Content="✕"
                            Click="MultiSelectExit_Click"
                            ToolTip="선택 모드 종료"
                            Margin="4,0,0,0"
                            Padding="8,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="Bold"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
